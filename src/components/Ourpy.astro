---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import v1 from '../assets/Images/v1.png';
import v2 from '../assets/Images/v2.png';
import v3 from '../assets/Images/v3.png';
import '../styles/global.css';
---

<div id="proyecto" >
	<main class=" min-h-screen px-8 py-12 text-primarytxt font-cormorant bg-[#343935]">
        <h2 class="text-6xl text-center mb-12">Nuestros proyectos</h2>
      
        <!-- Carrusel horizontal -->
        <div class="flex flex-row justify-center w-full gap-6 overflow-x-auto scroll-smooth pb-4">
          <!-- Card de propiedad -->
          <div class="w-full md:basis-[33%]">
            <a href={'/sale/proy1'}>
              <img src="/proy1/1.jpg" alt="Proyecto 1" class="w-full h-64 object-cover rounded-t-md mb-6" />
            </a>
            <div class="text-center py-4 border-y border-teal-500" >
              <h3 class="text-lg font-semibold">Casa</h3>
              <p>Km. 20 Carretera a San José Pínula, Colonia Lo de Valdez.</p>
              <p class="mt-2 text-sm">3 Habitaciones | Sala familiar | Terraza privada</p>
              <p class="text-sm max-md:hidden">Espaciosos ambientes y amplios ventanales, dormitorio y patio de servicio</p>
            </div>
          </div>
      
          <!-- Otra propiedad -->
          <div class="w-full md:basis-[33%]">
            <a href={'/sale/proy2'}>
              <img src="/proy2/1.jpg" alt="Casa 2" class="w-full h-64 object-cover rounded-t-md mb-6" />
            </a>
            <div class="text-center py-4 border-y border-teal-500">
              <h3 class="text-lg font-semibold">Casa</h3>
              <p>km 0 Carr. a El Salvador, Condominio Terra vista</p>
              <p class="mt-2 text-sm">0 Habitaciones | 0 Baños</p>
              <p class="text-sm max-md:hidden">La residencia esta diseñada pensando en ser un proyecto único en el área, por su ubicación y nivel de acabados.</p>
            </div>
          </div>
      
          <!-- Otra propiedad -->
          <div class="w-full md:basis-[33%] ">
            <a href={'/sale/proy3'}>
              <img src="/proy3/1.jpg" alt="Casa 3" class="w-full h-64 object-cover rounded-t-md mb-6" />
            </a>
            <div class="text-center py-4 border-y border-teal-500">
              <h3 class="text-lg font-semibold">Single-family home</h3>
              <p>km 20.5 carretera a Fraijanes, Condominio Vila Verde 1</p>
              <p class="mt-2 text-sm">3 Habitaciones | 3 Baños | Sala familiar</p>
              <p class="text-sm max-md:hidden">Amplio Jardin porque entendemos la importancia de estar en contacto con el exterior estando es casa</p>
            </div>
          </div>
        </div>
      </main>     
	
</div>

<style>
	.contact-link {
        display: inline-block; /* Asegura que el enlace solo ocupe el espacio necesario */
    }
</style>
