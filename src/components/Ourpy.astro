---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import v1 from '../assets/Images/v1.png';
import v2 from '../assets/Images/v2.png';
import v3 from '../assets/Images/v3.png';
import '../styles/global.css';
---

<div id="proyecto" >
	<main class=" min-h-screen px-8 py-12 text-primarytxt font-cormorant bg-[#343935]">
        <h2 class="text-6xl text-center mb-12">Nuestros proyectos</h2>
      
        <!-- Carrusel horizontal -->
        <div class="flex flex-row justify-center w-full gap-6 overflow-x-auto scroll-smooth pb-4">
          <!-- Card de propiedad -->
          <div class="w-full md:basis-[33%]">
            <a href={'/sale/casa1'}>
              <img src="/proyecto/p1.jpg" alt="Casa 1" class="w-full h-64 object-cover rounded-t-md mb-6" />
            </a>
            <div class="text-center py-4 border-y border-teal-500" >
              <h3 class="text-lg font-semibold">Casa</h3>
              <p>Kilómetro 20, Carr. San José Pinula, colonia Lo de Valdez</p>
              <p class="mt-2 text-sm">3 Habitaciones | 3 Baños</p>
              <p class="text-sm md:hidden">Espaciosos ambientes, sala familiar, acabados de primera</p>
            </div>
          </div>
      
          <!-- Otra propiedad -->
          <div class="w-full md:basis-[33%]">
            <a href={'/sale/casa2'}>
              <img src="/proyecto/p2.jpg" alt="Casa 2" class="w-full h-64 object-cover rounded-t-md mb-6" />
            </a>
            <div class="text-center py-4 border-y border-teal-500">
              <h3 class="text-lg font-semibold">Casa</h3>
              <p>km 16.5 entrada a Olmeca, Carr. a El Salvador, Condominio Terra vista</p>
              <p class="mt-2 text-sm">5 Habitaciones | 6 Baños</p>
              <p class="text-sm max-md:hidden">Modernos acabados, cocina abierta y todos los ambientes con iluminacion natural es algo que caracteriza nuestra residencia</p>
            </div>
          </div>
      
          <!-- Otra propiedad -->
          <div class="w-full md:basis-[33%] ">
            <a href={'/sale/casa1'}>
              <img src="/proyecto/p3.jpg" alt="Casa 3" class="w-full h-64 object-cover rounded-t-md mb-6" />
            </a>
            <div class="text-center py-4 border-y border-teal-500">
              <h3 class="text-lg font-semibold">Single-family home</h3>
              <p>km 20.5 carretera a Fraijanes, Condominio Vila Verde 1</p>
              <p class="mt-2 text-sm">4 Habitaciones | 5 Baños</p>
              <p class="text-sm max-md:hidden">Amplio Jardin porque entendemos la importancia de estar en contacto con el exterior estando es casa</p>
            </div>
          </div>
        </div>
      </main>     
	
</div>

<style>
	.contact-link {
        display: inline-block; /* Asegura que el enlace solo ocupe el espacio necesario */
    }
</style>
