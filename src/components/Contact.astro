---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import '../styles/global.css';
---

<div id="container" class="bg-second-background">
	<main>
		<nav class="flex flex-col justify-between w-full min-h-screen text-center md:flex-row">
			<div class="w-full md:basis-[40%] flex flex-col justify-start h-screen p-4 text-secondtxt  gap-6">
				<img src={'/src/assets/Images/LogoInmob.png'} alt="Logo inmobiliaria" class="w-1/2 md:w-1/3 lg:w-1/3" />
				<h1 class="text-4xl">Contáctanos</h1>				
                <h3 class="w-3/4 text-1xl px-6 py-3 border border-secondtxt rounded-full">12 calle 1-25 zona 10 Edificio Geminis 10 Torre Norte, 12 Nivel oficina 1210</h3>
                <h3 class="w-3/4 text-1xl px-6 py-3 border border-secondtxt rounded-full">(502) 5426-4541</h3>
                <h3 class="w-3/4 text-1xl px-6 py-3 border border-secondtxt rounded-full">campo.inmobiliario@outlook.com</h3>
			</div>
			<div class="w-full md:basis-[60%] flex flex-col justify-center">
				<h1 class="text-4xl text-secondtxt">Nuestros horarios</h1>				
                <h3 class="w-1/2 text-1xl px-6 py-3 border border-secondtxt bg-[#35686D] rounded-4xl">Lunes a viernes<br> 8:30 a.m. a 5:00 p.m.<br> Sábado <br> 9:00 a.m. a 12:00 p.m.</h3>
                
			</div>
		</nav>
	</main>
	
</div>

<style>
	.contact-link {
        display: inline-block; /* Asegura que el enlace solo ocupe el espacio necesario */
    }
</style>
