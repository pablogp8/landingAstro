---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import LogoInmob from '../assets/Images/LogoInmob.png';
import '../styles/global.css';
---

<div id="container" class="bg-second-background">
	<main>
		<nav class="grid xm:grid-cols-6 xl:grid-cols-5 lg:grid-cols-4 mm:grid-cols-3 max-mm:grid-cols-1 max-mm:grid-rows-5 grid-rows-4 w-full h-screen text-center md:flex-row pl-6">
			<img src={LogoInmob.src} alt="Logo inmobiliaria" class="col-start-1 col-end-3 size-1/2  pt-6 object-scale-down object-left" />
            <div class="col-start-1 col-end-3 max-lg:col-end-2 flex flex-col justify-start text-secondtxt  gap-6 text-left pl-4 max-md:pl-0">
				<h1 class="text-4xl">Contáctanos</h1>				
                <h3 class="w-2/3 max-lg:w-full max-md:w-10/11 text-1xl px-6 py-3 border border-secondtxt rounded-full">12 calle 1-25 zona 10 Edificio Geminis 10 Torre Norte, 12 Nivel oficina 1210</h3>
                <h3 class="w-2/3 max-lg:w-full max-md:w-10/11 text-1xl px-6 py-3 border border-secondtxt rounded-full">(502) 5426-4541</h3>
                <h3 class="w-2/3 max-lg:w-full max-md:w-10/11 text-1xl px-6 py-3 border border-secondtxt rounded-full">campo.inmobiliario@outlook.com</h3>
			</div>
			<div class="mm:col-start-3 max-mm:col-start-1   col-end-6 max-mm:row-start-4 flex flex-col justify-start max-lg:px-14 max-md:px-0 text-left gap-6">
				<h1 class="text-4xl text-secondtxt">Nuestros horarios</h1>				
                <h3 class="w-3/5 max-lg:w-3/3 max-md:w-10/11 text-2xl px-4 py-9 border  border-secondtxt bg-[#35686D] rounded-4xl">Lunes a viernes<br> 8:30 a.m. a 5:00 p.m.<br> Sábado <br> 9:00 a.m. a 12:00 p.m.</h3>
                
			</div>
		</nav>
	</main>
	
</div>

<style>
	.contact-link {
        display: inline-block; /* Asegura que el enlace solo ocupe el espacio necesario */
    }
</style>
