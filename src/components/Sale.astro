---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import v1 from '../assets/Images/v1.png';
import v2 from '../assets/Images/v2.png';
import v3 from '../assets/Images/v3.png';
import '../styles/global.css';
---

<div id="venta" >
	<main class="bg-[#1b1f1d] min-h-screen w-full h-screen px-4 md:px-8 py-12 text-primarytxt font-cormorant" >
        <h2 class="text-6xl text-center mb-12 pt-4">Propiedades a la venta</h2>
      
        <div class="relative h-[calc(85vh-6rem)] overflow-hidden">
          <!-- Botones de navegación -->
          <button id="prevBtn" class="hidden md:flex absolute left-0 top-1/2 transform -translate-y-1/2 bg-teal-600 text-white p-2 rounded-full z-10 hover:bg-teal-500">&#8592;</button>
          <button id="nextBtn" class="hidden md:flex absolute right-0 top-1/2 transform -translate-y-1/2 bg-teal-600 text-white p-2 rounded-full z-10 hover:bg-teal-500">&#8594;</button>
      
          <!-- Carrusel -->
          <div id="carousel" class="flex transition-transform duration-500 h-full overflow-hidden" >
            <!-- Cada slide ocupa 1/5 del carrusel (20%) -->
            <div class="w-full sm:w-1/2 lg:w-1/3 h-full flex flex-col justify-center items-center p-4">
              <div class="w-full max-w-sm bg-[#1b1f1d] border-t border-teal-500">
                <a href={'/sale/proy2'}>
                <img src="/proy2/1.jpg" alt="Casa 1" class="w-full h-64 object-cover rounded-t-md hover:scale-105 transition-transform duration-300" />
                </a>
                <div class="text-center py-4">
                  <h3 class="text-lg font-semibold">Lo de Valdez, proyecto 2</h3>
                  <p>Km. 20 Carretera a San José Pínula, Colonia Lo de Valdez.</p>
                  <p class="mt-2 text-sm">3 Habitaciones | 3 Baños</p>
                  <p class="text-sm">Acabados de primera</p>
                </div>
              </div>
            </div>
            <div class="w-full sm:w-1/2 lg:w-1/3 h-full flex flex-col justify-center items-center p-4">
              <div class="w-full max-w-sm bg-[#1b1f1d] border-t border-teal-500">
                <a href={'/sale/proy3'}>
                  <img src="/proy3/2.jpg" alt="Casa 2" class="w-full h-64 object-cover rounded-t-md hover:scale-105 transition-transform duration-300" />
                </a>
                <div class="text-center py-4">
                  <h3 class="text-lg font-semibold">Lo de Valdez, proyecto 3 </h3>
                  <p>Km. 20 Carretera a San José Pínula, Colonia Lo de Valdez.</p>
                  <p class="mt-2 text-sm">3 Habitaciones | 3 Baños | Sala familiar</p>
                  <p class="text-sm">Acabados de primera</p>
                </div>
              </div>
            </div>         
          </div>
        </div>
      </main>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
</style>
<script>
    const carousel = document.getElementById('carousel');
    const slides = Array.from(carousel.children);
    const totalSlides = slides.length; /* total de slides 2*/
    const visibleSlides = 1;
    const slideWidth = 100 / totalSlides;/* porcentaje de cada slide 50*/
    let currentIndex = 0;
    let intervalId= null;    

    carousel.style.width = `${totalSlides * 100}%`;
    slides.forEach(slide => {
      slide.style.width = `${slideWidth}%`;
    });

    function updateCarousel() {
      const offset = (currentIndex * slideWidth);
      carousel.style.transform = `translateX(-${offset}%)`;
    }

    function nextSlide() {
      currentIndex = (currentIndex + visibleSlides) % totalSlides;
      updateCarousel();
    }

    function prevSlide() {
      currentIndex = (currentIndex - visibleSlides + totalSlides) % totalSlides;
      updateCarousel();
    }

    
    function startCarousel() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(nextSlide, 5000);
    }

    function pauseCarousel() {
      clearInterval(intervalId);
    }

    function resumeCarousel() {
      startCarousel();
    }

    function isMobile() {
      return window.matchMedia("(max-width: 768px)").matches;
    }


    document.getElementById('nextBtn').addEventListener('click', nextSlide);
    document.getElementById('prevBtn').addEventListener('click', prevSlide);

    // Inicializa según el tamaño actual
    if (isMobile()) {
        startCarousel();
    }
    
    // Escucha cambios de tamaño de pantalla
  window.addEventListener("resize", () => {
    pauseCarousel();
    if (isMobile()) startCarousel();
  });
  </script>