---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import logo from '../assets/Images/LogoInmob.png';
import cocina1 from '../assets/Images/cocina1.png';
import '../styles/global.css';
---

<div id="inicio" >
	<main>
		<nav class="flex flex-row items-center justify-between w-full min-h-screen text-center max-md:flex-col max-md:h-full max-md:justify-normal max-md:gap-0 max-md:pb-4">
			<div class="w-[50%] max-md:w-full flex flex-col justify-start h-screen max-md:h-1/2 text-primarytxt font-cormorant gap-40 max-md:gap-0">
				<img src={logo.src} alt="Logo inmobiliaria" class="w-1/2 md:w-1/3 lg:w-2/4 p-6 max-md:hidden" />
				<div class="px-8 flex flex-col justify-start gap-25 max-md:gap-0 max-md:items-center max-md:pt-20">
					<h1 class="xm:text-9xl xl:text-8xl lg:text-7xl mm:text-7xl max-md:text-5xl px-8 text-left max-md:text-center">¡Construimos tus sueños!</h1>
					<a href="/semail"
					class="text-2xl w-[40%] max-lg:w-[75%] max-md:hidden px-6 py-2 ml-9 border border-teal-500 text-teal-100 rounded-full hover:bg-teal-500 hover:text-black hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ease-in-out">
						¡Haz una cita!
					</a>	
				</div>
				
			</div>
			<div class="w-[50%] max-md:w-3/3 max-md:py-5  text-white">
				<img src={cocina1.src} alt="Astro Logo" class="w-full max-md:h-1/3" />
			</div>
			<a href="/semail"
			class="text-2xl w-[40%] max-lg:w-[75%] md:hidden px-6 py-2 border border-teal-500 text-teal-100 rounded-full hover:bg-teal-500 hover:text-black hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ease-in-out">
				¡Haz una cita!
			</a>
			<!-- Botón flotante de WhatsApp -->
			<a href="https://wa.me/50254264541?text=Hola%2C%20quiero%20m%C3%A1s%20informaci%C3%B3n%20sobre%20una%20propiedad" target="_blank"
			class="fixed bottom-6 right-6 bg-white hover:bg-green-700 text-white p-2 rounded-full shadow-lg transition z-50">
				<svg class="w-8 h-8" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 58 58" xml:space="preserve">
					<g>
						<path style="fill:#2CB742;" d="M0,58l4.988-14.963C2.457,38.78,1,33.812,1,28.5C1,12.76,13.76,0,29.5,0S58,12.76,58,28.5
							S45.24,57,29.5,57c-4.789,0-9.299-1.187-13.26-3.273L0,58z"/>
						<path style="fill:#FFFFFF;" d="M47.683,37.985c-1.316-2.487-6.169-5.331-6.169-5.331c-1.098-0.626-2.423-0.696-3.049,0.42
							c0,0-1.577,1.891-1.978,2.163c-1.832,1.241-3.529,1.193-5.242-0.52l-3.981-3.981l-3.981-3.981c-1.713-1.713-1.761-3.41-0.52-5.242
							c0.272-0.401,2.163-1.978,2.163-1.978c1.116-0.627,1.046-1.951,0.42-3.049c0,0-2.844-4.853-5.331-6.169
							c-1.058-0.56-2.357-0.364-3.203,0.482l-1.758,1.758c-5.577,5.577-2.831,11.873,2.746,17.45l5.097,5.097l5.097,5.097
							c5.577,5.577,11.873,8.323,17.45,2.746l1.758-1.758C48.048,40.341,48.243,39.042,47.683,37.985z"/>
					</g>
				</svg>
		  	</a>
			
		</nav>
	</main>
	
</div>

<style>
	.contact-link {
        display: inline-block; /* Asegura que el enlace solo ocupe el espacio necesario */
    }
</style>
