---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import logo from '../assets/Images/LogoInmob.png';
import cocina1 from '../assets/Images/cocina1.png';
import '../styles/global.css';
---

<div id="inicio" >
	<main>
		<nav class="flex flex-row items-center justify-between w-full min-h-screen text-center max-md:flex-col max-md:h-full max-md:justify-normal max-md:gap-0 max-md:pb-4">
			<div class="w-[50%] max-md:w-full flex flex-col justify-start h-screen max-md:h-1/2 text-primarytxt font-cormorant gap-40 max-md:gap-0">
				<img src={logo.src} alt="Logo inmobiliaria" class="w-1/2 md:w-1/3 lg:w-2/4 p-6" />
				<div class="px-8 flex flex-col justify-start gap-25 max-md:gap-0 max-md:items-center">
					<h1 class="xm:text-9xl xl:text-8xl lg:text-7xl mm:text-7xl max-md:text-5xl px-8 text-left max-md:text-center">¡Construimos tus sueños!</h1>
					<a href="#contacto"
					class="text-2xl w-[40%] max-lg:w-[75%] max-md:hidden px-6 py-2 ml-9 border border-teal-500 text-teal-100 rounded-full hover:bg-teal-500 hover:text-black hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ease-in-out">
						¡Haz una cita!
					</a>	
				</div>
				
			</div>
			<div class="w-[50%] max-md:w-3/3 max-md:py-5  text-white">
				<img src={cocina1.src} alt="Astro Logo" class="w-full max-md:h-1/3" />
			</div>
			<a href="#contacto"
			class="text-2xl w-[40%] max-lg:w-[75%] md:hidden px-6 py-2 ml-9 border border-teal-500 text-teal-100 rounded-full hover:bg-teal-500 hover:text-black hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ease-in-out">
				¡Haz una cita!
			</a>
		</nav>
	</main>
	
</div>

<style>
	.contact-link {
        display: inline-block; /* Asegura que el enlace solo ocupe el espacio necesario */
    }
</style>
