---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import '../styles/global.css';
---

<div id="container" >
	<main>
		<nav class="flex flex-col items-center justify-between w-full min-h-screen text-center md:flex-row">
			<div class="w-[50%] flex flex-col justify-start h-screen p-4 text-primarytxt font-cormorant gap-40">
				<img src={'/src/assets/Images/LogoInmob.png'} alt="Logo inmobiliaria" class="w-1/2 md:w-1/3 lg:w-2/4" />
				<div class="px-8 flex flex-col justify-start gap-25">
					<h1 class="text-9xl px-8 text-left">¡Construimos tus sueños!</h1>
				<a href="#contacto"
				class="text-2xl w-[40%] px-6 py-2 ml-9 border border-teal-500 text-teal-100 rounded-full hover:bg-teal-500 hover:text-black hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ease-in-out">
				¡Haz una cita!
				</a>	
				</div>
				
			</div>
			<div class="w-[50%] text-white">
				<img src={'/src/assets/Images/cocina1.png'} alt="Astro Logo" class="w-full min-h-screen" />
			</div>
		</nav>
	</main>
	
</div>

<style>
	.contact-link {
        display: inline-block; /* Asegura que el enlace solo ocupe el espacio necesario */
    }
</style>
